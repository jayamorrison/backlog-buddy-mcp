{
  "name": "backlog-buddy-mcp",
  "version": "0.1.0",
  "description": "MCP server that helps AI assistants write INVEST-quality user stories: checks, splitting suggestions and Jira/CSV/Markdown export.",
  "type": "module",
  "bin": {
    "backlog-buddy-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/stories.test.ts",
    "e2e": "node test/e2e.mjs",
    "start": "node dist/server.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server.js"
  },
  "keywords": ["mcp", "model-context-protocol", "user-stories", "agile", "product-owner", "invest", "jira"],
  "author": "Jay Morrison",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
